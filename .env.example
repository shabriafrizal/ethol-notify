# ETHOL credentials
ETHOL_USERNAME=your_email@student.pens.ac.id
# Either put the password here (chmod 600 this file), or point to a password file:
ETHOL_PASSWORD=
# ETHOL_PASSWORD_FILE=/home/YOUR_USER/.config/ethol-notify/password

# Telegram bot (create one with @BotFather)
TELEGRAM_BOT_TOKEN=
# Primary/admin chat id for notifications. Multiple ids can be comma-separated.
TELEGRAM_CHAT_ID=
# Extra chat ids to also receive notifications (comma-separated). These are
# viewer-only for presensi: they get a different message and no presensi button.
TELEGRAM_NOTIFY_CHAT_IDS=
# Telegram user id(s) allowed to press "Presensi sekarang". For a private chat
# this is the same as the chat id. In a group/channel, set your personal id.
TELEGRAM_ADMIN_USER_IDS=
# Chat id(s) that receive the admin presensi message + button.
TELEGRAM_ADMIN_CHAT_IDS=
# Chats the bot is allowed to respond to. Defaults to all notify chat ids.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional tuning
CHECK_INTERVAL_SECONDS=180
HTTP_TIMEOUT_SECONDS=20
REMIND_TASK_24H=1
REMIND_TASK_3H=1
# STATE_DIR=./state
# Automatically record presensi after a session has been open for a while
# (1=on, 0=off). Auto presensi never fires immediately on detection.
AUTO_PRESENSI=0
# Minimum wait before auto presensi, in seconds (600 = 10 minutes).
AUTO_PRESENSI_DELAY_SECONDS=600
